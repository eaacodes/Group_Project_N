# Boxplot
boxplot(
  prev_injuries ~ injured,
  data = players,
  names = c("Not injured", "Injured"),
  main = "Previous Injuries by Current Injury Status",
  xlab = "Current Injury Status",
  ylab = "Number of Previous Injuries",
  col = c("lightblue", "lightcoral")
)

# Wilcoxon rank-sum test
wilcox.test(
  prev_injuries ~ injured,
  data = players
)


