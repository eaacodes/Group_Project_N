# PART 1: ASHFORD UNITED MATCH DATA

# Load match data
ashford <- read.csv("ashford_matches_individual.csv")

# Inspect data
head(ashford)
str(ashford)
summary(ashford)

# Convert home_away into a factor
ashford$home_away <- as.factor(ashford$home_away)

# Number of home and away matches
table(ashford$home_away)

# Average goals scored at home and away
aggregate(goals_scored ~ home_away,
          data = ashford,
          mean)

# Boxplot of goals scored by venue
boxplot(goals_scored ~ home_away,
        data = ashford,
        main = "Goals Scored at Home and Away",
        xlab = "Match Venue",
        ylab = "Goals Scored",
        col = c("lightblue", "lightcoral"))


# PART 2: POISSON REGRESSION MODELS

# Model 1: Goals scored explained by home/away status
ashford_model1 <- glm(
  goals_scored ~ home_away,
  family = poisson(link = "log"),
  data = ashford
)

summary(ashford_model1)

# Exponentiated coefficients
exp(coef(ashford_model1))

# Goodness-of-fit test
pchisq(
  deviance(ashford_model1),
  df = df.residual(ashford_model1),
  lower.tail = FALSE
)

# Pearson dispersion statistic
sum(residuals(ashford_model1, type = "pearson")^2) /
  df.residual(ashford_model1)


# Model 2: Add shots on target
ashford_model2 <- glm(
  goals_scored ~ home_away + shots_on_target,
  family = poisson(link = "log"),
  data = ashford
)

summary(ashford_model2)

# Exponentiated coefficients
exp(coef(ashford_model2))

# Goodness-of-fit test
pchisq(
  deviance(ashford_model2),
  df = df.residual(ashford_model2),
  lower.tail = FALSE
)

# Pearson dispersion statistic
sum(residuals(ashford_model2, type = "pearson")^2) /
  df.residual(ashford_model2)


# Model 3: Add opponent rank
ashford_model3 <- glm(
  goals_scored ~ home_away + shots_on_target +
    opponent_rank,
  family = poisson(link = "log"),
  data = ashford
)

summary(ashford_model3)

# Compare Models 2 and 3
anova(ashford_model2, ashford_model3, test = "Chisq")


# Model 4: Add possession
ashford_model4 <- glm(
  goals_scored ~ home_away + shots_on_target +
    possession,
  family = poisson(link = "log"),
  data = ashford
)

summary(ashford_model4)

# Compare Models 2 and 4
anova(ashford_model2, ashford_model4, test = "Chisq")


# Diagnostic plots for Model 2
par(mfrow = c(2, 2))
plot(ashford_model2)
par(mfrow = c(1, 1))


# Identify match with highest goals scored
which.max(ashford$goals_scored)

# Inspect that match
ashford[8, ]

# Predicted goals for match 8
predict(
  ashford_model2,
  newdata = ashford[8, ],
  type = "response"
)

# PART 3: PLAYER INJURY DATA

# Load player data
players <- read.csv("league_players.csv")

# Inspect data
head(players)
str(players)
summary(players)

# Number of injured and non-injured players
table(players$injured)

# Overall injury percentage
mean(players$injured) * 100


# PART 4: INJURY BY PLAYING POSITION

# Injury counts by position
table(players$position, players$injured)

# Injury percentages by position
prop.table(
  table(players$position, players$injured),
  1
) * 100

# Bar chart of injury percentage by position
position_injury <- prop.table(
  table(players$position, players$injured),
  1
) * 100

barplot(
  position_injury[, "1"],
  main = "Injury Percentage by Playing Position",
  xlab = "Playing Position",
  ylab = "Percentage Injured",
  col = "steelblue"
)

# Chi-squared test: position and injury status
chisq.test(
  table(players$position, players$injured)
)

# PART 5: AGE AND INJURY STATUS

# Mean age by injury status
aggregate(age ~ injured, data = players, mean)

# Boxplot
boxplot(
  age ~ injured,
  data = players,
  names = c("Not injured", "Injured"),
  main = "Age by Injury Status",
  xlab = "Injury Status",
  ylab = "Age (years)",
  col = c("lightblue", "lightcoral")
)

# Welch two-sample t-test
t.test(age ~ injured, data = players)


# PART 6: PREVIOUS INJURIES AND CURRENT INJURY STATUS

# Mean previous injuries by current injury status
aggregate(prev_injuries ~ injured,
          data = players,
